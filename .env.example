# Required — see README "Getting started"
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-api-token
JIRA_DOMAIN=your-domain.atlassian.net

# Optional. Both take your own tracker project keys, comma-separated.
# There is no default for either: these name your projects, not anyone
# else's, so work-radar ships with them empty.
#
# Which projects 專案盤查 (/audit) scans. Unset, that page explains itself
# instead of guessing.
AUDIT_PROJECT_KEYS=
# Project priority order for the weekly overview draft, highest first.
# Anything unlisted sorts after it, alphabetically.
OVERVIEW_PROJECT_RANK=

# Optional — where the local JSON stores live. Defaults are under data/.
# MEMBER_STORE_PATH=
# TRACKING_STORE_PATH=
# OVERVIEW_NOTE_PATH=
